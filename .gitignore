*.xsa
*.elf

# The original generated proof-of-concept is deliberately preserved as legacy.
!legacy/**/*.bit
!legacy/**/*.xsa
!legacy/**/*.npz

# Third-party reference documents (redistribution not permitted)
docs/reference/

# Packaged release evidence stays committed, including its verification logs
!artifacts/release/**
