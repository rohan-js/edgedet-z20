## Phase 2: HLS CNN Accelerator Design

### 2.1 Start Simple — Single Conv2D IP

This is the **core of your project**. Write CNN operations in C++ and let Vitis HLS convert them to hardware.

```cpp
// conv2d.h
#ifndef CONV2D_H
#define CONV2D_H

#include <ap_fixed.h>
#include <hls_stream.h>

// Fixed-point types for resource efficiency
typedef ap_fixed<16,8> data_t;   // 16-bit fixed point
typedef ap_fixed<16,8> weight_t;
typedef ap_fixed<32,16> acc_t;    // 32-bit accumulator

#define IN_CH    3       // Input channels (RGB)
#define OUT_CH   16      // Output channels
#define IMG_H    32      // Input height
#define IMG_W    32      // Input width
#define K        3       // Kernel size

void conv2d_accel(
    data_t input[IN_CH][IMG_H][IMG_W],
    weight_t weights[OUT_CH][IN_CH][K][K],
    data_t output[OUT_CH][IMG_H-K+1][IMG_W-K+1]
);

#endif
```

```cpp
// conv2d.cpp — Vitis HLS will synthesize this into FPGA logic
#include "conv2d.h"

void conv2d_accel(
    data_t input[IN_CH][IMG_H][IMG_W],
    weight_t weights[OUT_CH][IN_CH][K][K],
    data_t output[OUT_CH][IMG_H-K+1][IMG_W-K+1])
{
    // HLS pragmas for optimization
    #pragma HLS INTERFACE m_axi port=input  bundle=gmem0
    #pragma HLS INTERFACE m_axi port=weights bundle=gmem1
    #pragma HLS INTERFACE m_axi port=output  bundle=gmem2
    #pragma HLS INTERFACE s_axilite port=return

    acc_t sum;

    // Output channel loop
    OUT_CH_LOOP:
    for (int oc = 0; oc < OUT_CH; oc++) {
        // Spatial loops
        ROW_LOOP:
        for (int oh = 0; oh < IMG_H - K + 1; oh++) {
            COL_LOOP:
            for (int ow = 0; ow < IMG_W - K + 1; ow++) {
                #pragma HLS PIPELINE II=1
                sum = 0;
                // Convolution kernel
                for (int ic = 0; ic < IN_CH; ic++) {
                    for (int kh = 0; kh < K; kh++) {
                        for (int kw = 0; kw < K; kw++) {
                            sum += input[ic][oh+kh][ow+kw] 
                                 * weights[oc][ic][kh][kw];
                        }
                    }
                }
                // ReLU activation fused
                output[oc][oh][ow] = (sum > 0) ? (data_t)sum : (data_t)0;
            }
        }
    }
}
```

> [!NOTE]
> **Key HLS pragmas explained:**
> - `#pragma HLS PIPELINE II=1` — Process one pixel per clock cycle
> - `#pragma HLS INTERFACE m_axi` — Connect to ARM via AXI bus
> - `ap_fixed<16,8>` — Use 16-bit fixed point instead of 32-bit float (4× less resources)

### 2.2 Add MaxPool Layer

```cpp
void maxpool2d(
    data_t input[OUT_CH][IMG_H-K+1][IMG_W-K+1],
    data_t output[OUT_CH][(IMG_H-K+1)/2][(IMG_W-K+1)/2])
{
    #pragma HLS INTERFACE m_axi port=input  bundle=gmem0
    #pragma HLS INTERFACE m_axi port=output bundle=gmem1
    #pragma HLS INTERFACE s_axilite port=return

    for (int c = 0; c < OUT_CH; c++) {
        for (int h = 0; h < (IMG_H-K+1)/2; h++) {
            for (int w = 0; w < (IMG_W-K+1)/2; w++) {
                #pragma HLS PIPELINE II=1
                data_t max_val = input[c][2*h][2*w];
                max_val = (input[c][2*h][2*w+1] > max_val) 
                        ? input[c][2*h][2*w+1] : max_val;
                max_val = (input[c][2*h+1][2*w] > max_val) 
                        ? input[c][2*h+1][2*w] : max_val;
                max_val = (input[c][2*h+1][2*w+1] > max_val) 
                        ? input[c][2*h+1][2*w+1] : max_val;
                output[c][h][w] = max_val;
            }
        }
    }
}
```

### 2.3 Complete CNN Accelerator Pipeline

```cpp
// cnn_top.cpp — Top-level function combining all layers
void cnn_top(
    data_t input[IN_CH][IMG_H][IMG_W],
    weight_t conv1_w[16][IN_CH][K][K],
    weight_t conv2_w[32][16][K][K],
    weight_t fc_w[NUM_CLASSES][32*FC_DIM*FC_DIM],
    data_t output[NUM_CLASSES])
{
    #pragma HLS DATAFLOW  // Enable layer pipelining

    // Intermediate buffers
    data_t conv1_out[16][30][30];
    data_t pool1_out[16][15][15];
    data_t conv2_out[32][13][13];
    data_t pool2_out[32][6][6];

    conv2d_relu(input, conv1_w, conv1_out);
    maxpool2d(conv1_out, pool1_out);
    conv2d_relu_2(pool1_out, conv2_w, conv2_out);
    maxpool2d_2(conv2_out, pool2_out);
    fc_layer(pool2_out, fc_w, output);
}
```

