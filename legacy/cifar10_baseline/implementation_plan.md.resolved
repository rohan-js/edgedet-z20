## Phase 4: ARM Software Development

### 4.1 Bare-Metal Application (Vitis SDK)

```c
// main.c — Running on ARM Cortex-A9
#include "xparameters.h"
#include "xaxidma.h"
#include "cnn_accel.h"  // Generated HLS driver

int main() {
    // Initialize DMA
    XAxiDma dma;
    XAxiDma_Config *dma_cfg = XAxiDma_LookupConfig(XPAR_AXIDMA_0_DEVICE_ID);
    XAxiDma_CfgInitialize(&dma, dma_cfg);

    // Load pre-trained weights to DDR
    load_weights(conv1_weights, conv2_weights, fc_weights);

    // Receive image from laptop via Ethernet
    receive_image(input_buffer);
    
    // Preprocess: resize to 32×32, normalize
    preprocess(input_buffer, processed_input);

    // Send to FPGA accelerator via DMA
    Xil_DCacheFlushRange((UINTPTR)processed_input, INPUT_SIZE);
    XAxiDma_SimpleTransfer(&dma, (UINTPTR)processed_input, 
                           INPUT_SIZE, XAXIDMA_DMA_TO_DEVICE);
    
    // Wait for result
    while (XAxiDma_Busy(&dma, XAXIDMA_DMA_TO_DEVICE));
    
    // Read output from FPGA
    XAxiDma_SimpleTransfer(&dma, (UINTPTR)output_buffer,
                           OUTPUT_SIZE, XAXIDMA_DEVICE_TO_DMA);
    while (XAxiDma_Busy(&dma, XAXIDMA_DEVICE_TO_DMA));

    // Postprocess: find class, draw bounding box
    int class_id = argmax(output_buffer, NUM_CLASSES);
    send_result_to_laptop(class_id, confidence);
    
    return 0;
}
```

### 4.2 Laptop-Side Script

```python
# laptop_client.py — Captures webcam and sends to ZedBoard
import cv2
import socket
import numpy as np
import struct

ZEDBOARD_IP = "192.168.1.10"
PORT = 5000

sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
sock.connect((ZEDBOARD_IP, PORT))

cap = cv2.VideoCapture(0)  # Laptop webcam

while True:
    ret, frame = cap.read()
    if not ret:
        break
    
    # Resize for CNN input
    resized = cv2.resize(frame, (32, 32))
    data = resized.tobytes()
    
    # Send frame to ZedBoard
    sock.sendall(struct.pack('>I', len(data)) + data)
    
    # Receive result
    result = sock.recv(1024)
    class_id, confidence = struct.unpack('>If', result)
    
    # Draw result
    label = f"Class {class_id}: {confidence:.1%}"
    cv2.putText(frame, label, (10, 30), 
                cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)
    cv2.imshow('ZedBoard Object Detection', frame)
    
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break
```

